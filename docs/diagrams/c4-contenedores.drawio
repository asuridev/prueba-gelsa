<mxfile host="app.diagrams.net">
  <diagram id="c4-contenedores" name="C4 - Contenedores">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Diagrama de contenedores (C4, nivel 2)&lt;/b&gt;&lt;br&gt;Sistema de pedidos: order · payment · notifications" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="760" height="60" as="geometry"/></mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Sistema de pedidos&lt;/b&gt;&lt;br&gt;[Sistema de software]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="960" height="1030" as="geometry"/></mxCell>
        <mxCell id="buyer" value="&lt;b&gt;Comprador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Hace pedidos y paga con tarjeta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="operator" value="&lt;b&gt;Operador de back-office&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Gestiona plantillas y la lista de supresión" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="spaBuyer" value="&lt;b&gt;SPA del comprador&lt;/b&gt;&lt;br&gt;[Contenedor: SPA]&lt;br&gt;&lt;br&gt;Tokeniza la tarjeta con Stripe. No se diseña aquí" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="300" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="spaBack" value="&lt;b&gt;SPA de back-office&lt;/b&gt;&lt;br&gt;[Contenedor: SPA]&lt;br&gt;&lt;br&gt;Edita plantillas. No se diseña aquí" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="830" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="order" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;[Contenedor: Java, Spring Boot]&lt;br&gt;&lt;br&gt;Crea, consulta y anula pedidos; orquesta el cobro hasta su desenlace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="payment" value="&lt;b&gt;payment-service&lt;/b&gt;&lt;br&gt;[Contenedor: Java, Spring Boot]&lt;br&gt;&lt;br&gt;Cobra con tarjeta; autoriza, captura, anula y devuelve" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="notif" value="&lt;b&gt;notifications-service&lt;/b&gt;&lt;br&gt;[Contenedor: Java, Spring Boot]&lt;br&gt;&lt;br&gt;Envía correo transaccional desde plantillas, una sola vez" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="830" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="orderDb" value="&lt;b&gt;order-db&lt;/b&gt;&lt;br&gt;[Contenedor: PostgreSQL]&lt;br&gt;&lt;br&gt;Pedidos y réplica del catálogo" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="payDb" value="&lt;b&gt;payment-db&lt;/b&gt;&lt;br&gt;[Contenedor: PostgreSQL]&lt;br&gt;&lt;br&gt;Cobros y medios de pago" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="notifDb" value="&lt;b&gt;notifications-db&lt;/b&gt;&lt;br&gt;[Contenedor: PostgreSQL]&lt;br&gt;&lt;br&gt;Mensajes, plantillas y supresión" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="990" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="broker" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;[Contenedor: broker de mensajería]&lt;br&gt;&lt;br&gt;Canales: paymentEvents, catalogEvents, notificationRequests, notificationEvents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="630" height="100" as="geometry"/></mxCell>
        <mxCell id="kc" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Sistema externo: IdP OIDC]&lt;br&gt;&lt;br&gt;Emite tokens de comprador, de back-office y de máquina (M2M)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="stripe" value="&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;[Sistema externo: pasarela de pago]&lt;br&gt;&lt;br&gt;Autoriza y captura cobros con tarjeta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="catalog" value="&lt;b&gt;catalog&lt;/b&gt;&lt;br&gt;[Sistema externo (emulado)]&lt;br&gt;&lt;br&gt;Dueño del catálogo; hoy lo emula un emisor de pruebas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="555" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="smtp" value="&lt;b&gt;Relay SMTP&lt;/b&gt;&lt;br&gt;[Sistema externo: correo]&lt;br&gt;&lt;br&gt;Entrega los correos al comprador" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="830" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="e1" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="buyer" target="spaBuyer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="operator" target="spaBack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Pedidos&lt;br&gt;[HTTPS/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="spaBuyer" target="order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Plantillas y supresión&lt;br&gt;[HTTPS/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="spaBack" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Cobra y consulta&lt;br&gt;[HTTP, M2M]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="order" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Cobra&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="payment" target="stripe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Lee y escribe&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;entryDx=0;entryDy=-5;" edge="1" parent="1" source="order" target="orderDb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Lee y escribe&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;entryDx=0;entryDy=-5;" edge="1" parent="1" source="payment" target="payDb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Lee y escribe&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="notif" target="notifDb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Eventos de cobro&lt;br&gt;[AMQP, outbox]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.825;entryY=0;" edge="1" parent="1" source="payment" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="PaymentAuthorized,&lt;br&gt;Captured, Canceled&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.079;exitY=0;entryX=0.167;entryY=1;" edge="1" parent="1" source="broker" target="order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="NotificationRequested&lt;br&gt;[AMQP, outbox]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.833;exitY=1;entryX=0.397;entryY=0;" edge="1" parent="1" source="order" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="NotificationRequested&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.365;exitY=1;entryX=0.167;entryY=0;" edge="1" parent="1" source="broker" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="EmailSent,&lt;br&gt;EmailDeliveryFailed&lt;br&gt;[AMQP, outbox]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.833;exitY=0;entryX=0.683;entryY=1;" edge="1" parent="1" source="notif" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="Eventos de producto&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="catalog" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="Envía correo&lt;br&gt;[SMTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="notif" target="smtp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="Tokens&lt;br&gt;[OIDC/JWT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#707070;fontSize=11;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.06;dashed=1;" edge="1" parent="1" source="kc" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Azul oscuro: persona · Azul: contenedor del sistema · Gris: sistema externo · Línea punteada gruesa: frontera del sistema · Flecha punteada: Keycloak emite los tokens que validan todos los contenedores.&lt;br&gt;Una base PostgreSQL por servicio. El único acceso síncrono entre servicios es order → payment; el resto va por eventos en RabbitMQ (con outbox transaccional)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="190" y="1150" width="960" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
