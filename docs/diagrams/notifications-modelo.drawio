        <mxCell id="rel2n" value="al enviar" style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1230.0" y="246.0" width="120" height="19" as="geometry"/></mxCell>
