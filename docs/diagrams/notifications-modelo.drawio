        <mxCell id="rel3l" value="copia del" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1253.5" y="376.0" width="73" height="18" as="geometry"/></mxCell>
        <mxCell id="rel3n" value="remitente" style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1230.0" y="397.0" width="120" height="19" as="geometry"/></mxCell>
        <mxCell id="note" value="El mensaje congela al aceptarse todo lo que el envío necesita (remitente, plantilla y versión), así que enviarlo no depende de cambios posteriores.&lt;br&gt;La plantilla y sus versiones cambian juntas: solo una versión está activa a la vez y el contenido de una versión nunca cambia.&lt;br&gt;Una dirección tiene un único registro para siempre: liberarla lo conserva y una nueva supresión lo reactiva. Cada entidad de la derecha es su propio agregado." style="rounded=1;arcSize=6;dashed=1;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1610" height="90" as="geometry"/></mxCell>
      </root>
