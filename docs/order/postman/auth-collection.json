{
  "info": {
    "name": "order — tokens",
    "description": "Un token de usuario por comprador de prueba (sub y email en el token). `eva-no-email` y `eva-bad-email` llevan un email ausente o inválido; `ana-expired` un token caducado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token — ana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "username",
              "value": "{{username_ana}}"
            },
            {
              "key": "password",
              "value": "{{password_ana}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_ana', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
