# Los servicios generados (services/<servicio>-<tech>/) se versionan aquí junto al diseño.
# Cada uno trae su propio .gitignore (build/, .gradle/, .idea/…) y se aplica por carpeta.

# Configuración local que genera `keel-<tech> build`: con credenciales de prueba y puertos
# de la máquina. No se sube; se regenera con `keel-<tech> build`.
services/*/deploy/.env
services/*/infra/test-credentials.env

# Logs sueltos
*.log

# Salida de compilar que dejan los IDE (VS Code / Eclipse) en bin/, y la de Gradle en build/
# (cada servicio ya ignora build/; bin/ no estaba cubierto).
services/*/bin/
services/*/build/
