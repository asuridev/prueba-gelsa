{
  "realm": "payment",
  "enabled": true,
  "accessTokenLifespan": 1800,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": []
  },
  "users": [],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "aud-payment",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "payment",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-wrong",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "audiencia-ajena",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "payment-method:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "payment-method:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "payment:charge",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "payment:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "payment:refund",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles",
    "profile"
  ],
  "clients": [
    {
      "clientId": "checkout",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "checkout-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-payment",
        "payment:charge",
        "payment:read",
        "payment-method:write",
        "payment-method:read"
      ]
    },
    {
      "clientId": "backoffice",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "backoffice-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-payment",
        "payment:read",
        "payment:refund"
      ]
    },
    {
      "clientId": "test-m2m-ok",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "test-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-payment",
        "payment-method:read",
        "payment-method:write",
        "payment:charge",
        "payment:read",
        "payment:refund"
      ]
    },
    {
      "clientId": "test-m2m-no-scope",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "test-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-payment"
      ]
    },
    {
      "clientId": "test-m2m-bad-aud",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "test-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-wrong",
        "payment-method:read",
        "payment-method:write",
        "payment:charge",
        "payment:read",
        "payment:refund"
      ]
    },
    {
      "clientId": "test-m2m-none",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "test-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile"
      ]
    }
  ]
}
