        "roles",
        "profile"
      ]
    },
    {
      "clientId": "billing",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "billing-secret",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "aud-notifications",
        "notification:send",
        "notification:read"
      ]
    },
    {
