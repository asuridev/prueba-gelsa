{
  "uid": "keel-notifications",
  "title": "notifications — Keel",
  "description": "Generado por keel-spring build. Lo REGENERA cada build: una edición hecha en la interfaz de Grafana se pierde. Para conservarla, exporta el JSON y sustituye el archivo de deploy/observability/dashboards/.",
  "tags": [
    "keel",
    "notifications"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Casos de uso",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ejecuciones por operación (por segundo)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (keel_operation) (rate(keel_use_case_seconds_count[$__rate_interval]))",
          "legendFormat": "{{keel_operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Tasa de error",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(keel_use_case_seconds_count{keel_outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(keel_use_case_seconds_count[$__rate_interval])), 0.001)",
          "legendFormat": "error",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "p95 por operación (con exemplars)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, keel_operation) (rate(keel_use_case_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{keel_operation}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
