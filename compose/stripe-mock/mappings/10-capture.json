{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/payment_intents/[^/]+/capture"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "object": "payment_intent",
      "id": "{{request.pathSegments.[2]}}",
      "status": "succeeded"
    }
  }
}