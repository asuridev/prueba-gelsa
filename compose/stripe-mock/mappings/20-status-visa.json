{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/payment_intents/pi_visa_[A-Za-z0-9]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "object": "payment_intent",
      "id": "{{request.pathSegments.[2]}}",
      "status": "requires_capture"
    }
  }
}