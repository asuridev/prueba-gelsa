{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/payment_intents",
    "bodyPatterns": [
      {
        "matches": "(^|.*&)payment_method=pm_card_chargeDeclinedInsufficientFunds(&.*|$)"
      }
    ]
  },
  "response": {
    "status": 402,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": {
        "type": "card_error",
        "code": "card_declined",
        "decline_code": "insufficient_funds",
        "message": "Your card has insufficient funds.",
        "payment_intent": {
          "object": "payment_intent",
          "id": "pi_declined_{{randomValue length=24 type='ALPHANUMERIC'}}",
          "status": "requires_payment_method"
        }
      }
    }
  }
}