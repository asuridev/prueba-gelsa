# Opcional: copia este archivo como .env (no se versiona) para cambiar algún valor.
# Sin .env, todo funciona con los valores por defecto y Stripe simulado.

# Stripe. Por defecto se usa el simulador (stripe-mock, WireMock) y no hace falta clave.
# Para usar Stripe real en modo test (no cobra dinero real), descomenta estas dos líneas y pon
# tu clave de https://dashboard.stripe.com/test/apikeys
# STRIPE_BASE_URL=https://api.stripe.com
# STRIPE_SECRET_KEY=sk_test_REEMPLAZAR

# Secreto del cliente M2M con el que order llama a payment (lo crea la siembra).
ORDER_PAYMENT_CLIENT_SECRET=order-local-secret

# Comprador de prueba del realm order.
BUYER_USERNAME=buyer
BUYER_PASSWORD=buyer
BUYER_EMAIL=buyer@example.com

# Puertos publicados en el host (cámbialos si alguno está ocupado).
ORDER_PORT=8081
PAYMENT_PORT=8082
NOTIFICATIONS_PORT=8083
KEYCLOAK_PORT=8180
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025
STRIPE_MOCK_PORT=8099
DB_PORT=5432
