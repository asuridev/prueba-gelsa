                ]
              }
            }
          ]
        },
        {
          "name": "Pedido que no existe: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderBaseUrl}}/orders/99999999-9999-4999-8999-999999999999"
          },
          "event": [
